# fastlane/.env.default — GITIGNORED, SECRETS ONLY. Copy to fastlane/.env.default and
# fill in (or scaffold with --inherit-secrets-from). NEVER commit this or the .p8.
# In CI these come from GitHub secrets instead (see .github/workflows/testflight.yml).

# App Store Connect API key (App Store Connect > Users and Access > Integrations)
APP_STORE_CONNECT_API_KEY_ID=XXXXXXXXXX
APP_STORE_CONNECT_API_ISSUER_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
APP_STORE_CONNECT_API_KEY_BASE64=<base64 of AuthKey_XXXX.p8>

# Apple Developer Team ID (10 chars)
DEVELOPER_TEAM_ID=XXXXXXXXXX

# Shared match repo (one distribution cert for all apps)
MATCH_GIT_URL=https://github.com/<you>/<match-repo>.git
MATCH_GIT_BRANCH=main
MATCH_PASSWORD=<match encryption passphrase>
MATCH_GIT_BASIC_AUTHORIZATION=<base64 of github_user:token>
