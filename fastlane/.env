# fastlane/.env — COMMITTED, non-secret per-app config. Fastlane auto-loads this
# (and fastlane/.env.default) on every run, locally and in CI. Safe to commit.
APP_IDENTIFIER=com.eugenechan.TimeTracker
APP_NAME=TimeTracker Eugene Personal
FASTLANE_PROJECT=TimeTracker.xcodeproj
FASTLANE_TARGET=TimeTracker
FASTLANE_SCHEME=TimeTracker
USES_XCODEGEN=false
